{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 24,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_EXTENSIONS": false,
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CTEX_WARNINGS_AS_ERRORS": true
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "headless",
            "displayName": "Native headless debug build",
            "inherits": "debug"
        },
        {
            "name": "headless-sanitize",
            "displayName": "Native headless ASan and UBSan build",
            "inherits": "debug",
            "cacheVariables": {
                "CTEX_ENABLE_SANITIZERS": true
            },
            "condition": {
                "type": "notEquals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-x64",
            "displayName": "Linux x86-64 release build",
            "inherits": "release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-universal",
            "displayName": "macOS universal release build",
            "inherits": "release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
            }
        },
        {
            "name": "windows-x64",
            "displayName": "Windows x86-64 release build",
            "inherits": "release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "ios-arm64",
            "displayName": "iOS arm64 release build",
            "inherits": "release",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "toolchainFile": "${sourceDir}/cmake/toolchains/ios.cmake"
        },
        {
            "name": "android-arm64",
            "displayName": "Android arm64-v8a release build",
            "inherits": "release",
            "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
            "cacheVariables": {
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_static"
            }
        }
    ],
    "buildPresets": [
        { "name": "headless", "configurePreset": "headless" },
        { "name": "headless-sanitize", "configurePreset": "headless-sanitize" },
        { "name": "linux-x64", "configurePreset": "linux-x64" },
        { "name": "macos-universal", "configurePreset": "macos-universal" },
        { "name": "windows-x64", "configurePreset": "windows-x64" },
        { "name": "ios-arm64", "configurePreset": "ios-arm64" },
        { "name": "android-arm64", "configurePreset": "android-arm64" }
    ],
    "testPresets": [
        {
            "name": "headless",
            "configurePreset": "headless",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "headless-sanitize",
            "configurePreset": "headless-sanitize",
            "output": { "outputOnFailure": true },
            "environment": {
                "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        }
    ]
}
